flowchart TB
    SRC["Java 源码"] --> JAVAC["外部 javac<br/>前端处理与内部转换 → 字节码生成<br/>到此已完成一次源码编译"]
    JAVAC --> BC["class 字节码<br/>也可以位于 JAR 中"]
    subgraph SF["Soot 的前端职责：处理字节码输入"]
        LOAD["加载、解析类与方法<br/>此路线不重做 Java 源码的①②③"]
        IR["构建 Jimple 方法体<br/>对应④：中间表示构建"]
        LOAD --> IR
    end
    subgraph SM["Soot 的分析与变换职责"]
        GRAPH["基于 Jimple 构建 CFG 等结构"]
        ANALYZE["执行数据流等分析<br/>按需进行程序变换<br/>与⑤所依赖的分析、变换职责相对应"]
        GRAPH --> ANALYZE
    end
    BC --> LOAD
    IR --> GRAPH
    ANALYZE --> REPORT["分析结果<br/>例如各程序点的污点事实"]
    ANALYZE -. "需要输出程序时" .-> EMIT["Soot 输出后端<br/>例如生成变换后的字节码<br/>对应⑥的代码生成职责"]
    classDef front fill:#eaf2ff,stroke:#527bbd,color:#142c50;
    classDef mid fill:#e7f5ed,stroke:#40855b,color:#163823;
    classDef back fill:#fff1dd,stroke:#b07829,color:#51330d;
    classDef note fill:#f4f4f4,stroke:#777,color:#333;
    class LOAD,IR front;
    class GRAPH,ANALYZE mid;
    class EMIT back;
    class SRC,JAVAC,BC,REPORT note;

